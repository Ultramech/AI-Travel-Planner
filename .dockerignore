# Keep the build context small and never ship secrets or local state into an
# image. Without this, `.env`, the 400 MB virtualenv and every notebook are
# sent to the daemon and baked into layers.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Secrets and local state
.env
.env.*
!.env.example
data/
# …but the reference tables in it are build inputs, not local state. They fill
# real gaps in the bundled datasets (Kerala's railway stations, Madgaon,
# Jaipur's airport) and geo.py degrades silently without them, so leaving them
# out makes Docker quietly worse than a local run rather than failing loudly.
!data/*.csv
*.sqlite
*.sqlite3

# Not needed at runtime
.git/
.gitignore
tests/
legacy/
notebooks/
*.ipynb
output/
*.exe
*.png
docs/
README.md
SESSION_HANDOFF.md
