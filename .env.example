# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
# All of these were previously hardcoded in source and pushed to a public repo —
# the old values must be treated as compromised and rotated.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# LLM_PROVIDER: gemini (default) | groq. Only the active provider's key is needed.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Leave the models empty to use the provider default
# (gemini -> gemini-2.5-flash, groq -> openai/gpt-oss-120b).
LLM_MODEL=
LLM_EXTRACTOR_MODEL=
LLM_TEMPERATURE=0.2

# --- Third-party data providers -------------------------------------------
# Weather comes from Open-Meteo (free, no key). WEATHER_API_KEY is no longer used.
WEATHER_API_KEY=
SERPAPI_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test
# Flight source: auto | google | amadeus
# 'google' needs NO API key at all.
FLIGHT_PROVIDER=auto
TAVILY_API_KEY=

# --- Redis (cache + pub/sub fan-out + optional checkpointer) ---------------
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# --- Kafka (durable job queue + event log) ---------------------------------
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REQUESTS=trip.requests
KAFKA_TOPIC_EVENTS=trip.events
KAFKA_TOPIC_DLQ=trip.dlq
KAFKA_CONSUMER_GROUP=trip-planner-workers

# --- Database (durable trip history) ---------------------------------------
# OPTIONAL. Leave empty to run with no persistence: planning still works, but
# there is no trip history and a completed plan lives only in Redis for 24h.
#
# Any Postgres URI works — the driver is normalised automatically, so paste it
# exactly as your provider gives it:
#   local      DATABASE_URL=postgresql://user@localhost:5432/travel_planner
#   Supabase   DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   (Supabase: Project Settings -> Database -> Connection string -> URI)
#
# Prefer the SESSION pooler (port 5432). The TRANSACTION pooler (6543) also
# works for the app, but the LangGraph Postgres checkpointer needs session-mode
# connections — keep CHECKPOINTER_BACKEND=sqlite if you must use 6543.
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# After setting DATABASE_URL, create the tables:  make migrate

# --- Checkpointer: memory | sqlite | redis | postgres -----------------------
# sqlite   durable, zero infrastructure, but SINGLE NODE — a second worker on
#          another machine cannot resume a trip this one paused.
# postgres one shared store, so any worker can resume any trip. Requires
#          DATABASE_URL. This is what makes `--scale worker=N` real.
CHECKPOINTER_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=data/checkpoints/trips.sqlite

# --- Scraping --------------------------------------------------------------
SCRAPER_ENABLED=true
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=35
SELENIUM_REMOTE_URL=

# --- Service ---------------------------------------------------------------
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
GRAPH_RECURSION_LIMIT=40
